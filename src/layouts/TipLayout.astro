---
import { ViewTransitions } from 'astro:transitions';

const { title, tips, current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const idx = tips.findIndex((t) => t.slug === current.slug);
const prev = idx > 0 ? tips[idx - 1] : null;
const next = idx < tips.length - 1 ? tips[idx + 1] : null;
const href = (slug) => `${base}/${slug}`;
const total = tips.length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <ViewTransitions />
    <style>
      :root {
        color-scheme: light dark;
        --bg: #fbfbfd;
        --surface: #ffffff;
        --text: #1a1a1f;
        --muted: #6b7280;
        --border: #e6e6ec;
        --accent: #2f7d4f;
        --accent-soft: #e8f4ec;
        --radius: 16px;
        --shadow: 0 1px 2px rgba(16, 24, 40, 0.04), 0 8px 24px rgba(16, 24, 40, 0.06);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0e0f13;
          --surface: #16181d;
          --text: #ececf1;
          --muted: #9aa1ad;
          --border: #262931;
          --accent: #5cc98a;
          --accent-soft: #17251d;
          --shadow: 0 1px 2px rgba(0, 0, 0, 0.3), 0 8px 24px rgba(0, 0, 0, 0.4);
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        line-height: 1.7;
        background: var(--bg);
        color: var(--text);
        -webkit-font-smoothing: antialiased;
      }
      main { max-width: 42rem; margin: 0 auto; padding: clamp(1.5rem, 4vw, 3.5rem) 1.25rem 4rem; }

      .eyebrow {
        display: inline-block;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--accent);
        background: var(--accent-soft);
        padding: 0.3rem 0.7rem;
        border-radius: 999px;
        margin-bottom: 1rem;
      }
      h1 {
        font-size: clamp(1.7rem, 5vw, 2.35rem);
        line-height: 1.2;
        letter-spacing: -0.02em;
        margin: 0 0 1.75rem;
      }

      article {
        font-size: 1.075rem;
        color: var(--text);
      }
      article :is(p, li) { margin: 0 0 1.1rem; }
      article strong { font-weight: 650; }

      nav {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.9rem;
        margin-top: 3.5rem;
      }
      .navcard {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 1rem 1.15rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--surface);
        box-shadow: var(--shadow);
        text-decoration: none;
        color: var(--text);
        transition: transform 0.15s ease, border-color 0.15s ease;
      }
      .navcard:hover {
        transform: translateY(-2px);
        border-color: var(--accent);
      }
      .navcard.next { text-align: right; align-items: flex-end; }
      .navcard.placeholder {
        box-shadow: none;
        background: transparent;
        border-style: dashed;
        cursor: default;
        opacity: 0.55;
      }
      .navcard.placeholder:hover { transform: none; border-color: var(--border); }
      .dir {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: 0.35rem;
      }
      .navcard.next .dir { flex-direction: row-reverse; }
      .label {
        font-weight: 600;
        font-size: 1rem;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      @media (max-width: 34rem) {
        nav { grid-template-columns: 1fr; }
        .navcard.next { text-align: left; align-items: flex-start; }
        .navcard.next .dir { flex-direction: row; }
        .label { -webkit-line-clamp: 1; }
      }

      /* Entrance animation for the article content. */
      @keyframes rise {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: none; }
      }
      .eyebrow { animation: rise 0.45s ease both; }
      h1 { animation: rise 0.45s ease 0.05s both; }
      article { animation: rise 0.5s ease 0.1s both; }
      nav { animation: rise 0.5s ease 0.16s both; }

      @media (prefers-reduced-motion: reduce) {
        .eyebrow, h1, article, nav { animation: none; }
      }

      /* Swipe-style directional page transitions. */
      @keyframes slide-out-left { to { transform: translateX(-40px); opacity: 0; } }
      @keyframes slide-in-right { from { transform: translateX(40px); opacity: 0; } }
      @keyframes slide-out-right { to { transform: translateX(40px); opacity: 0; } }
      @keyframes slide-in-left { from { transform: translateX(-40px); opacity: 0; } }

      /* Going to the NEXT tip: current slides left, new enters from the right. */
      [data-dir="next"]::view-transition-old(root) {
        animation: slide-out-left 0.28s ease both;
      }
      [data-dir="next"]::view-transition-new(root) {
        animation: slide-in-right 0.28s ease both;
      }
      /* Going to the PREVIOUS tip: current slides right, new enters from the left. */
      [data-dir="prev"]::view-transition-old(root) {
        animation: slide-out-right 0.28s ease both;
      }
      [data-dir="prev"]::view-transition-new(root) {
        animation: slide-in-left 0.28s ease both;
      }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) { animation: none; }
      }
    </style>
  </head>
  <body>
    <main>
      <span class="eyebrow">Tip {idx + 1} of {total}</span>
      <h1>{current.title}</h1>
      <article set:html={current.bodyHtml} />
      <nav>
        {prev ? (
          <a class="navcard prev" href={href(prev.slug)}>
            <span class="dir">← Previous</span>
            <span class="label">{prev.title}</span>
          </a>
        ) : (
          <span class="navcard prev placeholder">
            <span class="dir">← Previous</span>
            <span class="label">You're at the start</span>
          </span>
        )}
        {next ? (
          <a class="navcard next" href={href(next.slug)}>
            <span class="dir">Next →</span>
            <span class="label">{next.title}</span>
          </a>
        ) : (
          <span class="navcard next placeholder">
            <span class="dir">Next →</span>
            <span class="label">You're all caught up</span>
          </span>
        )}
      </nav>
    </main>

    <script is:inline>
      // Set the swipe direction before an Astro view transition starts so the
      // page slides left/right to match the prev/next intent. Delegated on
      // `document`, which persists across transitions (the body is swapped).
      if (!window.__navDirBound) {
        window.__navDirBound = true;
        document.addEventListener('click', (e) => {
          const card = e.target.closest('.navcard');
          if (!card || card.classList.contains('placeholder')) return;
          document.documentElement.dataset.dir = card.classList.contains('next')
            ? 'next'
            : 'prev';
        });
        // Keyboard/history navigation has no clear left-right intent; clear it.
        document.addEventListener('astro:before-preparation', (e) => {
          if (e.navigationType === 'traverse') delete document.documentElement.dataset.dir;
        });
      }
    </script>
  </body>
</html>

