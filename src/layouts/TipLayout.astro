---
import { ViewTransitions } from 'astro:transitions';

const { title, tips, current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const idx = tips.findIndex((tip: { slug: string }) => tip.slug === current.slug);
const prev = idx > 0 ? tips[idx - 1] : null;
const next = idx < tips.length - 1 ? tips[idx + 1] : null;
const href = (slug: string) => `${base}/${slug}`;
const navTitle = (title: string) => title
  .replace(/^Tip\s+\d+\s+[—-]\s+/, '')
  .replace(/\s*\(.+\)$/, '');
const total = tips.length;
const progress = ((idx + 1) / total) * 100;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title}</title>
    <ViewTransitions />
    <style>
      :root {
        color-scheme: light dark;
        --bg: #fbfbfd;
        --surface: #ffffff;
        --text: #1a1a1f;
        --muted: #6b7280;
        --border: #e6e6ec;
        --accent: #c9151d;
        --accent-soft: #fdebed;
        --radius: 16px;
        --shadow: 0 1px 2px rgba(16, 24, 40, 0.04), 0 8px 24px rgba(16, 24, 40, 0.06);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0e0f13;
          --surface: #16181d;
          --text: #ececf1;
          --muted: #9aa1ad;
          --border: #262931;
          --accent: #ff6268;
          --accent-soft: #32171a;
          --shadow: 0 1px 2px rgba(0, 0, 0, 0.3), 0 8px 24px rgba(0, 0, 0, 0.4);
        }
      }
      @media (min-width: 48rem) {
        html { font-size: 125%; }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        line-height: 1.7;
        background: var(--bg);
        color: var(--text);
        -webkit-font-smoothing: antialiased;
      }
      main { max-width: 42rem; margin: 0 auto; padding: clamp(1.5rem, 4vw, 3.5rem) 1.25rem 4rem; }

      .tip-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
      }

      .all-tips {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin: 0;
        color: var(--muted);
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
      }
      .all-tips:hover { color: var(--accent); }
      .all-tips:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

      .eyebrow {
        display: inline-block;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--accent);
        background: var(--accent-soft);
        padding: 0.3rem 0.7rem;
        border-radius: 999px;
        margin: 0;
        white-space: nowrap;
      }

      /* Subtle "trail" progress bar with a tire-track dashed fill. */
      .trail {
        position: relative;
        height: 6px;
        border-radius: 999px;
        background: color-mix(in srgb, var(--muted) 22%, transparent);
        margin: 0.45rem 0 1.75rem;
      }
      .trail-fill {
        height: 100%;
        border-radius: 999px;
        background-color: var(--accent);
        background-image: repeating-linear-gradient(
          90deg,
          rgba(255, 255, 255, 0.45) 0 4px,
          transparent 4px 8px
        );
        transition: width 0.4s ease;
        view-transition-name: trail-progress;
      }
      .trail-marker {
        position: absolute;
        left: clamp(0.7rem, var(--progress), calc(100% - 0.7rem));
        top: 50%;
        transform: translate(-50%, -55%);
        transition: left 0.4s ease;
        view-transition-name: trail-rider;
      }
      .trail-rider {
        display: block;
        font-size: 1.5rem;
        line-height: 1;
        transform: scaleX(-1);
        filter: drop-shadow(0 2px 1px color-mix(in srgb, var(--bg) 85%, transparent));
      }
      h1 {
        font-size: clamp(1.7rem, 5vw, 2.35rem);
        line-height: 1.2;
        letter-spacing: -0.02em;
        margin: 0 0 1.75rem;
      }

      article {
        font-size: 1.075rem;
        color: var(--text);
      }
      article :is(p, li) { margin: 0 0 1.1rem; }
      article strong { font-weight: 650; }

      nav {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.9rem;
        margin-top: 3.5rem;
      }
      .navcard {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 1rem 1.15rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--surface);
        box-shadow: var(--shadow);
        text-decoration: none;
        color: var(--text);
        transition: transform 0.15s ease, border-color 0.15s ease;
      }
      .navcard:hover {
        transform: translateY(-2px);
        border-color: var(--accent);
      }
      .navcard.next { text-align: right; align-items: flex-end; }
      .navcard.placeholder {
        box-shadow: none;
        background: transparent;
        border-style: dashed;
        cursor: default;
        opacity: 0.55;
      }
      .navcard.placeholder:hover { transform: none; border-color: var(--border); }
      .dir {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: 0.35rem;
      }
      .navcard.next .dir { flex-direction: row-reverse; }
      .label {
        font-weight: 600;
        font-size: 1rem;
        line-height: 1.3;
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      @media (max-width: 34rem) {
        nav { grid-template-columns: 1fr; }
        .navcard.next { text-align: left; align-items: flex-start; }
        .navcard.next .dir { flex-direction: row; }
      }

      /* Entrance animation for the article content. */
      @keyframes rise {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: none; }
      }
      .eyebrow { animation: rise 0.45s ease both; }
      h1 { animation: rise 0.45s ease 0.05s both; }
      article { animation: rise 0.5s ease 0.1s both; }
      nav { animation: rise 0.5s ease 0.16s both; }

      @media (prefers-reduced-motion: reduce) {
        .eyebrow, h1, article, nav { animation: none; }
        .trail-fill, .trail-marker { transition: none; }
      }

      /* Swipe-style directional page transitions. */
      @keyframes slide-out-left { to { transform: translateX(-40px); opacity: 0; } }
      @keyframes slide-in-right { from { transform: translateX(40px); opacity: 0; } }
      @keyframes slide-out-right { to { transform: translateX(40px); opacity: 0; } }
      @keyframes slide-in-left { from { transform: translateX(-40px); opacity: 0; } }

      /* Going to the NEXT tip: current slides left, new enters from the right. */
      [data-dir="next"]::view-transition-old(root) {
        animation: slide-out-left 0.28s ease both;
      }
      [data-dir="next"]::view-transition-new(root) {
        animation: slide-in-right 0.28s ease both;
      }
      /* Going to the PREVIOUS tip: current slides right, new enters from the left. */
      [data-dir="prev"]::view-transition-old(root) {
        animation: slide-out-right 0.28s ease both;
      }
      [data-dir="prev"]::view-transition-new(root) {
        animation: slide-in-left 0.28s ease both;
      }

      ::view-transition-group(trail-progress),
      ::view-transition-group(trail-rider) {
        animation-duration: 0.65s;
        animation-timing-function: cubic-bezier(0.22, 0.8, 0.25, 1);
      }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root),
        ::view-transition-group(trail-progress),
        ::view-transition-group(trail-rider) { animation: none; }
      }
    </style>
  </head>
  <body>
    <main>
      <div class="tip-header">
        <a class="all-tips" href={`${base}/`} aria-label="View all tips">← All tips</a>
        <span class="eyebrow">Tip {idx + 1} of {total}</span>
      </div>
      <div class="trail" style={`--progress: ${progress}%`} role="presentation">
        <div class="trail-fill" style={`width: ${progress}%`}></div>
        <span class="trail-marker"><span class="trail-rider">🚵</span></span>
      </div>
      <h1>{current.title}</h1>
      <article set:html={current.bodyHtml} />
      <nav>
        {prev ? (
          <a class="navcard prev" href={href(prev.slug)}>
            <span class="dir">← Previous</span>
            <span class="label">{navTitle(prev.title)}</span>
          </a>
        ) : (
          <span class="navcard prev placeholder">
            <span class="dir">← Previous</span>
            <span class="label">You're at the start</span>
          </span>
        )}
        {next ? (
          <a class="navcard next" href={href(next.slug)}>
            <span class="dir">Next →</span>
            <span class="label">{navTitle(next.title)}</span>
          </a>
        ) : (
          <span class="navcard next placeholder">
            <span class="dir">Next →</span>
            <span class="label">You're all caught up</span>
          </span>
        )}
      </nav>
    </main>

    <script is:inline>
      // Set the swipe direction before an Astro view transition starts so the
      // page slides left/right to match the prev/next intent. Delegated on
      // `document`, which persists across transitions (the body is swapped).
      if (!window.__navDirBound) {
        window.__navDirBound = true;
        document.addEventListener('click', (e) => {
          const card = e.target.closest('.navcard');
          if (!card || card.classList.contains('placeholder')) return;
          document.documentElement.dataset.dir = card.classList.contains('next')
            ? 'next'
            : 'prev';
        });
        // Keyboard/history navigation has no clear left-right intent; clear it.
        document.addEventListener('astro:before-preparation', (e) => {
          if (e.navigationType === 'traverse') delete document.documentElement.dataset.dir;
        });
      }
    </script>
  </body>
</html>

