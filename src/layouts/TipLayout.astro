---
const { title, tips, current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const idx = tips.findIndex((t) => t.slug === current.slug);
const prev = idx > 0 ? tips[idx - 1] : null;
const next = idx < tips.length - 1 ? tips[idx + 1] : null;
const href = (slug) => `${base}/${slug}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <style>
      :root { color-scheme: light dark; }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
        line-height: 1.6;
        background: Canvas;
        color: CanvasText;
      }
      main { max-width: 44rem; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
      h1 { font-size: 1.6rem; margin: 0 0 0.25rem; }
      article :is(p, li) { font-size: 1.1rem; }
      nav {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 3rem;
        padding-top: 1.25rem;
        border-top: 1px solid color-mix(in srgb, CanvasText 20%, transparent);
      }
      nav a { text-decoration: none; font-weight: 600; }
      nav a:hover { text-decoration: underline; }
      nav span { opacity: 0.4; }
    </style>
  </head>
  <body>
    <main>
      <h1>{current.title}</h1>
      <article set:html={current.bodyHtml} />
      <nav>
        {prev ? <a href={href(prev.slug)}>← {prev.title}</a> : <span>← Start</span>}
        {next ? <a href={href(next.slug)}>{next.title} →</a> : <span>End →</span>}
      </nav>
    </main>
  </body>
</html>
